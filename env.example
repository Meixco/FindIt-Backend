# Buat secret acak (minimal 32 karakter), jalankan:
# node -e "import('node:crypto').then(c=>console.log(c.randomBytes(48).toString('hex')))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN_SECONDS=1800

# Super admin pertama (dibuat sekali jika tabel admins masih kosong).
# Setelah berhasil login, HAPUS ADMIN_SEED_PASSWORD dari file ini.
ADMIN_SEED_USERNAME=admin@kampus.ac.id
ADMIN_SEED_PASSWORD=ganti-dengan-password-kuat-12-karakter-atau-lebih

UPLOAD_DIR=uploads
FRONTEND_URL=http://localhost:5173
